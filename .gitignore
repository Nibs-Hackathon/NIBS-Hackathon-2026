.vercel

# Secrets — never commit real env files
.env
.env.*
!.env.example
!**/.env.example

# Python
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

# Node
node_modules/
frontend/dist/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Cursor local hooks (rules may be committed intentionally)
.cursor/hooks.json
.cursor/hooks/

# Runtime / generated caches
backend/graphify-out/
graphify-out/cache/
graphify-out/20*/
**/graphify-out/cache/
.graphify_query_cache/

# Test / tooling noise
frontend/playwright-report/
frontend/test-results/
*.tmp
