# Configure keys from separate Google projects to gain independent quota pools.
# Comma-separated pools rotate for both Gemini chat and Gemini embeddings.
GEMINI_API_KEYS=replace-with-key-1,replace-with-key-2

# Alternatively, use individually named keys.
# GEMINI_API_KEY_1=replace-with-key-1
# GEMINI_API_KEY_2=replace-with-key-2

# Optional model override.
# GEMINI_MODEL=gemini-3.5-flash-lite

# PostgreSQL. Replace every placeholder locally; never commit the real URL.
# DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/rigos
#
# Cloudflare Access/Spectrum, Pinggy, or other TCP tunnel endpoints can use
# host-only form plus credentials. If cloudflared forwards to a local port,
# use postgresql://postgres:password@127.0.0.1:<forwarded-port>/rigos instead.
# DATABASE_URL=tcp://your-tunnel-host:port
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-password
# POSTGRES_DB=rigos

# Bounded defaults for a remote/older PostgreSQL host.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5

# Simulator/performance tuning. Defaults provide a fast first portfolio pass,
# then a realistic bounded cadence without overlapping workflow storms.
# RIGOS_AUTO_INCIDENTS=true
# RIGOS_SIMULATION_TICK_SECONDS=2
# RIGOS_SIMULATION_WARMUP_SECONDS=8
# RIGOS_INITIAL_INCIDENT_DELAY=5
# RIGOS_COVERAGE_INCIDENT_DELAY=12
# RIGOS_INCIDENT_MIN_DELAY=45
# RIGOS_INCIDENT_MAX_DELAY=90
# RIGOS_MAX_ACTIVE_INCIDENTS=3
# RIGOS_TELEMETRY_PERSIST_EVERY=5
# RIGOS_SNAPSHOT_CACHE_SECONDS=4
# RIGOS_WEBSOCKET_SNAPSHOT_SECONDS=5

# Run the full simulator and MAO workflow locally without PostgreSQL or Gemini.
# LOCAL_DEMO_MODE=true
